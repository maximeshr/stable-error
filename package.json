{
  "name": "stable-error",
  "version": "2.0.0",
  "description": "A TypeScript library for generating stable, consistent error IDs based on error messages",
  "keywords": [
    "analytics",
    "dashboard",
    "error",
    "id",
    "stable",
    "tracking",
    "typescript"
  ],
  "homepage": "https://github.com/maximeshr/stable-error#readme",
  "bugs": {
    "url": "https://github.com/maximeshr/stable-error/issues"
  },
  "license": "MIT",
  "author": "Maxime Sahroui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maximeshr/stable-error.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "changeset": "changeset",
    "check:version": "node scripts/check-version.mjs",
    "version-packages": "changeset version",
    "release": "vp pack && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26"
  }
}
