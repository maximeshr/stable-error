{
  "name": "stable-error",
  "version": "2.0.0",
  "description": "A TypeScript library for generating stable, consistent error IDs based on error messages",
  "keywords": [
    "analytics",
    "dashboard",
    "error",
    "id",
    "stable",
    "tracking",
    "typescript"
  ],
  "homepage": "https://github.com/maximeshr/stable-error#readme",
  "bugs": {
    "url": "https://github.com/maximeshr/stable-error/issues"
  },
  "license": "MIT",
  "author": "Maxime Sahroui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maximeshr/stable-error.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "prepublishOnly": "vp run build",
    "check:version": "quality-gate check-version",
    "version-packages": "changeset version",
    "release": "vp pack && vp run check:package && changeset publish",
    "check:package": "quality-gate check-package",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "quality-gate": "github:maximeshr/quality-gate#v0.3.1",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.12"
  }
}
